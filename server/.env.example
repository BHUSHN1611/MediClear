# Server Environment Variables
PORT=3001
NODE_ENV=development

# Allowed client origins for CORS (may contain multiple comma-separated URLs)
CLIENT_URL=http://localhost:5173

# Optional CORS origin regular expression (e.g. for dynamic Vercel preview/deployment URLs)
# Example: CORS_ORIGIN_REGEX=^https:\/\/medi-clear-[a-zA-Z0-9]+-bhushn-team\.vercel\.app$
CORS_ORIGIN_REGEX=

# Database (Phase 2+)
MONGODB_URI=mongodb://localhost:27017/mediclear

# Google Gemini API (Phase 3+)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Storage & Privacy
UPLOAD_DIR=./uploads
DOCUMENT_RETENTION_DAYS=30
